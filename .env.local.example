# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's gitignored, keep it that way.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Our CM Our Pride

# --- Supabase (Dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — bypasses RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Dashboard -> Settings -> API Keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- SMTP (Google Workspace Gmail) ---
# Host mailbox -> Google Account -> Security -> App passwords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-workspace-email@ourcmourpride.com
SMTP_PASS=
SMTP_FROM=Our CM Our Pride <your-workspace-email@ourcmourpride.com>

# --- Admin ---
# Inbox that receives contact-form submissions and new-registration alerts.
# Falls back to SMTP_USER if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Google Drive (optional — participant photo upload) ---
# See docs/SETUP.md section 10e for the one-time setup script flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=
